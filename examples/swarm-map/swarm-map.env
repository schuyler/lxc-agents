# Template for /etc/swarm-map/swarm-map.env (root:root 0600). container-setup.sh
# substitutes @APP_PORT@ and appends HSM_OPERATOR_TOKEN (generated once, never
# overwritten). Values must be unquoted KEY=value lines.
NODE_ENV=production
PORT=@APP_PORT@
HOME=/home/swarm
DATA_DIR=/home/swarm/.hermes-swarm-map
NEXT_TELEMETRY_DISABLED=1
