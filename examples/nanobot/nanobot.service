[Unit]
Description=Nanobot AI Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nanobot
WorkingDirectory=/home/nanobot/code
ExecStart=/home/nanobot/code/.venv/bin/nanobot gateway
Restart=on-failure
RestartSec=10
Environment=VIRTUAL_ENV=/home/nanobot/code/.venv
Environment=PROJECT_PATH=/home/nanobot/code

[Install]
WantedBy=multi-user.target
